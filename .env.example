# Local demo needs no broker or AI credentials. Never commit .env.
OPTIONLAB_DATABASE_URL=sqlite:///./optionlab.db
OPTIONLAB_EXECUTION_MODE=paper
OPTIONLAB_DATA_SOURCE=DEMO
OPTIONLAB_DEMO_ENABLED=true
OPTIONLAB_AUTH_REQUIRED=false
OPTIONLAB_API_TOKEN=
OPTIONLAB_AI_PROVIDER=offline
OPTIONLAB_OPENAI_API_KEY=
# Choose an accessible model explicitly before setting AI_PROVIDER=openai.
OPTIONLAB_OPENAI_MODEL=
OPTIONLAB_KITE_API_KEY=
OPTIONLAB_KITE_ACCESS_TOKEN=
OPTIONLAB_STARTING_CASH=500000
OPTIONLAB_MAX_TRADE_PREMIUM=25000
OPTIONLAB_MAX_TOTAL_PREMIUM=100000
OPTIONLAB_MAX_DAILY_LOSS=10000
OPTIONLAB_MAX_POSITIONS=5
OPTIONLAB_MAX_QUOTE_AGE_SECONDS=60
OPTIONLAB_PROPOSAL_TTL_SECONDS=120
# Simulation assumption; does not represent a complete Indian tax/fee schedule.
OPTIONLAB_PAPER_FEE_PER_ORDER=20
# Hosting: use render.yaml instead of copying this local .env onto Render.
OPTIONLAB_ENVIRONMENT=local
# Optional canonical origin. On Render, RENDER_EXTERNAL_URL is used automatically.
OPTIONLAB_PUBLIC_ORIGIN=
OPTIONLAB_SESSION_HOURS=8
# Render supplies DATABASE_URL and PORT. Explicit OPTIONLAB_DATABASE_URL takes precedence.
